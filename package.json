{
  "name": "palantir-analytics-tool",
  "version": "2.0.0",
  "description": "The tool that help you to see the mysterious of Portals",
  "main": "src/app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "npm run build:core -- --mode=production",
    "build:core": "webpack --config webpack.config.js",
    "lint": "eslint --ext .js src --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "nyc --check-coverage --reporter=text mocha --config ./.mocharc.yaml ./src/**/*.test.js",
    "zip": "npm run lint && npm run test && npm run build && node ./build-zip.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olxbr/palantir-analytics-tool.git"
  },
  "keywords": [
    "chrome",
    "extension",
    "matching",
    "dev",
    "tools"
  ],
  "author": "@squad-matching",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/olxbr/palantir-analytics-tool/issues"
  },
  "homepage": "https://github.com/olxbr/palantir-analytics-tool#readme",
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "@babel/preset-env": "^7.15.0",
    "@babel/register": "^7.15.3",
    "ansi-regex": ">=5.0.1",
    "babel-core": "^6.26.3",
    "babel-loader": "^8.2.2",
    "babel-plugin-module-resolver": "^4.1.0",
    "babel-plugin-root-import": "^6.6.0",
    "babel-preset-env": "^1.7.0",
    "babel-preset-stage-0": "^6.24.1",
    "babel-register": "^6.26.0",
    "chai": "*",
    "copy-webpack-plugin": "^9.0.1",
    "css-minimizer-webpack-plugin": "^3.3.1",
    "eslint": "^7.32.0",
    "geteventlisteners": "^1.1.0",
    "jsdom": "^19.0.0",
    "jsdom-global": "3.0.2",
    "mini-css-extract-plugin": "^2.4.5",
    "mocha": "*",
    "nyc": "^15.1.0",
    "remove-files-webpack-plugin": "^1.4.5",
    "terser-webpack-plugin": "^5.3.0",
    "webpack": "^5.51.1",
    "webpack-cli": "^4.9.1",
    "zip-dir": "^2.0.0"
  }
}